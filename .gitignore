# OS
.DS_Store
Thumbs.db
desktop.ini

# editors
.vscode/
.idea/
*.swp

# node (no runtime deps; only if you add tooling later)
node_modules/
package-lock.json

# local scratch — headless-browser profiles and render dumps used when
# verifying the build; never commit these
chromeprofile*/
cp[0-9]*/
dom*.html
shot-*.html
off*.html
diag*.html
mobile-*.html
*.err
*.tmp

# commit message scratch
.commitmsg

# raw iTunes responses cached by build/harvest.js so a re-run to change only
# the selection rules costs nothing. Derived data; regenerate, never commit.
build/.harvest-cache/
